<main>
    {{include /page_html/solutions/{this.path_part}.html }}

    <section class="bg-gray-100 p-5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h3 class="font-display text-2xl md:text-3xl font-semibold mb-5">Explore Successes from Customers who've implemented a {{this.title}} solution with Content.One</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4" id="customersGrid">
            {{each customer as customer where related_solutions LIKE '%{this.zuid}%'}}
            <div data-customer-card data-code="{{customer.short_code}}">
              <article class="customer-card bg-white shadow-sm h-full rounded-2xl overflow-hidden flex flex-col">
                <div class="customer-card__media relative">
                    <img src="{{customer.header_image.getImage(640,360)}}" alt="{{customer.name}} background" class="w-full h-full object-cover">
                    <div class="customer-card__overlay absolute inset-0"></div>
                    <div class="customer-card__logo absolute inset-0 flex items-center justify-center">
                    {{if {customer.logo} }}
                        <img src="{{customer.logo.getImage(220,120)}}" alt="{{customer.name}} logo">
                    {{else}}
                        <span class="font-semibold text-white">{{customer.short_code}}</span>
                    {{end-if}}
                    </div>
                </div>
                <div class="p-6 flex-1">
                    <h3 class="font-display text-xl font-bold mb-2">{{customer.name}}</h3>
                    <p class="text-gray-600 mb-3">{{customer.short_description.subwords(20)}}...</p>
                </div>
                <footer class="px-6 pb-6 bg-transparent">
                    <a href="{{customer.getURL()}}" class="inline-flex items-center justify-center w-full rounded-lg border border-royal text-royal hover:bg-royal/10 font-semibold px-4 py-2.5 transition">Learn More</a>
                </footer>
              </article>
            </div>
            {{/each}}
            </div>
        </div>
    </section>

    {{ block('/-/block/client_logos.html') }}
    {{blocks('/-/block/sales_personal_cta.html') }}
</main>
