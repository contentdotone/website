 {{include /page_html/industries/{this.path_part}.html}}

 <style>
   .hero-agency-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #121739 0%, #121739 25%, rgba(18, 23, 57, 0) 100%);
    pointer-events: none;
    z-index: 1;
  }
 </style>

 <main>
  <section class="jarallax py-4 hero-agency relative" data-jarallax data-speed="0.4">
    <div class="hero-agency-content absolute left-0 right-0" style="z-index: 2">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12">
          <div class="xl:col-span-5 lg:col-span-7">
            <div class="text-center lg:text-left">
              <div class="mb-4 text-white">
                <small class="uppercase tracking-widest">Digital Content Solutions</small>
                <h1 class="mb-3 mt-3 text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white">{{this.title}}</h1>
                <div class="text-lg m-0">{{this.title_by_line}}</div>
              </div>
              {{include /components/ctas/book-button.html}}
            </div>
          </div>
        </div>
      </div>
    </div>
    <img class="jarallax-img" src="{{this.header_background_image.getImage(1000)}}" alt="agency" />
    <div class="hero-agency-overlay"></div>
  </section>

  <section class="jarallax py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-slate max-w-none">
        {{this.body}}
      </div>
    </div>
  </section>

{{if {this.cta_block} }}
  {{blocks({this.cta_block})}}
{{/if}}
{{if {this.above_the_footer_block} }}
  {{blocks({this.above_the_footer_block})}}
{{/if}}

</main>
