<!-- Blog article page — Figma 13847:35436 (desktop) + 35971 / 36993 / 37758 / 38522 (responsive).
     Dark hero (category chip + title + date/read time + cover image), 2-col body
     (sticky author sidebar + article content), dark "Book a Demo" CTA at bottom.
     .article-content typography + Bootstrap-compat block preserved so CMS-authored
     body copy renders correctly. -->
<main class="article-page">

  <!-- ════════════ HERO — Figma 13846:33756 (5 breakpoints) ════════════ -->
  <section class="article-hero bg-[#060813] pt-14 lg:pt-20 pb-12 lg:pb-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <div>
          {{if {this.category} }}
          <span class="inline-block bg-white/10 text-white/85 font-semibold uppercase text-xs tracking-[0.16em] rounded px-3 py-1.5 mb-5">{{categories.filter({this.category}).name}}</span>
          {{end-if}}
          <h1 class="font-display text-white font-semibold leading-[1.15] mb-4 text-3xl md:text-4xl lg:text-[44px]" style="letter-spacing:-0.02em">{{this.title}}</h1>
          <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-white/60">
            {{if {this.publish_date} }}
            <span>{{this.publish_date.date(Y-m-d)}}</span>
            {{end-if}}
            <span id="articleReadTime">Estimating read time...</span>
          </div>
        </div>
        {{if {this.main_image} }}
        <div class="w-full">
          <button class="w-full block p-0 border-0 bg-transparent cursor-zoom-in" type="button" data-hero-lightbox data-hero-src="{{this.main_image.getImage()}}" aria-label="Open hero image">
            <img src="{{this.main_image.getImage(1200,720,crop)}}" alt="{{this.title}} cover image" class="w-full aspect-[5/3] object-cover rounded-2xl border border-white/10" loading="eager" />
          </button>
        </div>
        {{end-if}}
      </div>
    </div>
  </section>

  <!-- ════════════ BODY ════════════ -->
  <section class="article-body-section bg-white py-16 lg:py-24">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[240px_minmax(0,1fr)] gap-10 lg:gap-16 items-start">

        <!-- ─── Sticky sidebar: author + CTA. On lg+ sits left of body;
             on smaller widths order flips so author + bio + CTA render
             below the article content, capped at 416px and centered. ─── -->
        <aside class="article-aside order-2 lg:order-1 w-full max-w-[416px] mx-auto lg:max-w-none lg:mx-0 lg:sticky lg:top-24 flex flex-col gap-6">
          {{if {this.authors} }}
          <div class="flex flex-col gap-6">
            {{each {this.authors} as author}}
            <a href="{{author.getURL()}}" class="flex items-center gap-3 no-underline group">
              {{if {author.image} }}
              <img src="{{author.image.getImage(96,96,crop)}}" alt="{{author.name}}" class="w-11 h-11 rounded-full object-cover border border-black/10 shrink-0" loading="lazy" />
              {{else}}
              <span class="w-11 h-11 rounded-full bg-royal text-white flex items-center justify-center font-semibold shrink-0">{{author.name.subwords(1)}}</span>
              {{end-if}}
              <div class="flex flex-col min-w-0">
                <span class="text-sm font-semibold text-ink group-hover:text-royal transition">{{author.name}}</span>
                {{if {author.title} }}
                <span class="text-xs text-gray-500 truncate">{{author.title}}</span>
                {{end-if}}
              </div>
            </a>
            {{if {author.bio} }}
            <p class="text-sm leading-relaxed m-0" style="color:#525252">{{author.bio}}</p>
            {{end-if}}
            {{/each}}
          </div>
          {{end-if}}

          <a href="/contact-us/" class="inline-flex items-center justify-center rounded-full bg-royalDark hover:bg-royal transition text-white font-semibold px-5 py-3 text-sm shadow-sm">
            Book a Demo
          </a>
        </aside>

        <!-- ─── Body copy ─── -->
        <article class="article-content order-1 lg:order-2 max-w-[720px]">
          {{this.body}}
        </article>

      </div>
    </div>
  </section>

  <!-- ════════════ BOOK A DEMO CTA ════════════ -->
  <section class="bg-[#060813] py-16 lg:py-20">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-white text-2xl lg:text-3xl font-semibold mb-3 leading-[1.2]" style="letter-spacing:-0.02em">Book a Demo</h2>
      <p class="text-white/70 mb-8">See how Content.One helps enterprise marketing teams manage, scale, and ship in every market.</p>
      <a href="/contact-us/" class="inline-flex items-center rounded-full bg-royal hover:bg-white hover:text-royal transition text-white font-semibold px-6 py-3">
        Schedule a Meeting
      </a>
    </div>
  </section>

  {{if {this.bottom_cta} }}
  {{blocks({this.bottom_cta})}}
  {{end-if}}

</main>

<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap");
  @import url("https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700&display=swap");

  .article-page { font-family: "Satoshi", "Segoe UI", sans-serif; color: #0B0F1C; }

  /* Body copy typography — Tailwind's preflight resets h1-h6 to inherit, so
     restore visual hierarchy here for anything rendered inside .article-content
     (the CMS-authored body). */
  .article-content h1,
  .article-content h2,
  .article-content h3,
  .article-content h4,
  .article-content h5,
  .article-content h6 {
    font-family: "DM Sans", "Segoe UI", sans-serif;
    color: #0B0F1C;
    line-height: 1.25;
