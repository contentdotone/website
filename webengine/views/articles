  .article-content h3 { font-size: 1.375rem; font-weight: 600; }
  .article-content h4 { font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .article-content h5 { font-size: 1rem; font-weight: 600; line-height: 1.4; }
  .article-content h6 { font-size: 0.875rem; font-weight: 600; line-height: 1.4; text-transform: uppercase; letter-spacing: 0.05em; }

