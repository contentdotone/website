(** Marketing Downloads - Two Column Layout with Zoho Form **)

<section class="py-12 lg:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

      (** Left Column - Content **)
      <div>
        {{if {!this.thumbnail_image} }}
          <img src="{{this.thumbnail_image.getImage(600)}}" alt="{{this.title}}" class="w-full rounded-2xl mb-4" />
        {{/if}}

        <h1 class="font-display text-4xl md:text-5xl font-bold mb-3">{{this.title}}</h1>

        {{if {!this.description} }}
          <p class="text-lg text-gray-500 mb-4">{{this.description}}</p>
        {{/if}}

        {{if {!this.download_type} }}
          <span class="inline-flex items-center bg-royal/10 text-royal rounded-full px-3 py-2 mb-4 text-sm font-semibold">
            <svg viewBox="0 0 24 24" class="w-4 h-4 mr-1" fill="currentColor" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.5" fill="white"/></svg>
            {{this.download_type}}
          </span>
        {{/if}}

        {{if {!this.full_description} }}
          <div class="content prose prose-slate max-w-none mb-4">
            {{this.full_description}}
          </div>
        {{/if}}

        {{if {!this.download_file} }}
          <div id="download-section" class="hidden"></div>
        {{/if}}
      </div>

      (** Right Column - Zoho Form / Download Button **)
      <div class="lg:sticky lg:top-8 self-start">
        <div class="bg-gray-50 shadow-sm rounded-2xl p-6 lg:p-10">

          (** Form Section **)
          <div id="zoho-form-container">
            <h2 class="font-display text-xl font-bold mb-2">Get Your Free Download</h2>
            <p class="text-gray-500 mb-4">Fill out the form below to access this resource.</p>

            <div class="my-6">
              <form action='https://forms.zohopublic.com/zestyio/form/ContentOneDemoForm/formperma/v5yu682DcRoFs5WJHMyNPgq30kitbSqJXuQGEZkwoVw/htmlRecords/submit'
                    name='form' method='POST'
                    accept-charset='UTF-8' enctype='multipart/form-data' id='form' class="grid grid-cols-1 md:grid-cols-2 gap-3 needs-validation"
                    novalidate>
                <input type="hidden" name="zf_referrer_name" value="">
                <input type="hidden" name="zf_redirect_url" value="">
                <input type="hidden" name="zc_gad" value="">

                <div>
                  <label for="ScheduleFirstnameInput" class="block text-sm font-medium text-gray-700 mb-1">First Name <span class="text-danger">*</span></label>
                  <input type="text" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-royal/40 focus:border-royal" id="ScheduleFirstnameInput" name="Name_First" maxlength="255" fieldType=7 placeholder="First Name" required />
                </div>
                <div>
                  <label for="scheduleLastnameInput" class="block text-sm font-medium text-gray-700 mb-1">Last Name <span class="text-danger">*</span></label>
                  <input type="text" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-royal/40 focus:border-royal" id="scheduleLastnameInput" name="Name_Last" maxlength="255" fieldType=7 placeholder="Last Name" required />
                </div>
                <div class="md:col-span-2">
                  <label for="scheduleEmailInput" class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-danger">*</span></label>
                  <input type="email" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-royal/40 focus:border-royal" id="scheduleEmailInput" name="Email" checktype="c5" value="" maxlength="255" fieldType=9 placeholder="Email" required />
                </div>
                <div class="md:col-span-2">
                  <label for="scheduleCompanyInput" class="block text-sm font-medium text-gray-700 mb-1">Company <span class="text-danger">*</span></label>
                  <input type="text" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-royal/40 focus:border-royal" id="scheduleCompanyInput" name="SingleLine" checktype="c1" value="" maxlength="255" fieldType=1 placeholder="Company" required />
                </div>
                <div class="md:col-span-2">
                  <label for="scheduleTextarea" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
                  <textarea class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-royal/40 focus:border-royal" id="scheduleTextarea" name="MultiLine" checktype="c1" maxlength="65535" placeholder="Please tell us about your project. (Optional)" rows="3"></textarea>
                </div>
                <div class="md:col-span-2">
                  <button onclick="gtag_report_conversion(); linkedin_conversion();" class="w-full inline-flex items-center justify-center rounded-lg bg-royal hover:bg-royalDark text-white font-semibold px-4 py-2.5 transition" type="submit">Access the Guide Now</button>
                </div>
              </form>
            </div>
          </div>

          <div id="download-button-section" class="hidden text-center py-12">
            <svg viewBox="0 0 24 24" class="w-12 h-12 text-success mx-auto" fill="currentColor"><path d="M12 22a10 10 0 1 1 0-20 10 10 0 0 1 0 20zm-1-12h-2v-2h2V8h2v2h2v2h-2v2h-2v-2z" transform="translate(0,4)"/><path d="M9 16l-3-3 1.4-1.4L9 13.2l6.6-6.6L17 8z" fill="white"/></svg>
            <h2 class="font-display text-xl font-bold mt-3 mb-2">Thank You!</h2>
            <p class="text-gray-500 mb-4">Your resource is ready to download.</p>
            <a id="download-now-btn" href="{{this.download_file.getImage()}}" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center rounded-full bg-success hover:bg-success/90 text-white font-bold px-5 py-3 shadow text-lg transition">
              <svg viewBox="0 0 24 24" class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              Download Now
            </a>
          </div>

        </div>
      </div>

      <script>
        (function () {
          'use strict';
          var form = document.getElementById('form');
          if (!form) return;
          form.addEventListener('submit', function (event) {
            if (!form.checkValidity()) {
              event.preventDefault();
              event.stopPropagation();
              form.classList.add('was-validated');
              return;
            }
            event.preventDefault();
            form.classList.add('was-validated');
            var formData = new FormData(form);
            fetch(form.action, { method: 'POST', body: formData, mode: 'no-cors' })
              .then(function() {
                document.getElementById('zoho-form-container').classList.add('hidden');
                document.getElementById('download-button-section').classList.remove('hidden');
                var ds = document.getElementById('download-section');
                if (ds) ds.classList.remove('hidden');
              }).catch(function() {
                document.getElementById('zoho-form-container').classList.add('hidden');
                document.getElementById('download-button-section').classList.remove('hidden');
                var ds = document.getElementById('download-section');
                if (ds) ds.classList.remove('hidden');
              });
          }, false);

          {{if {!this.requires_form} == 0 }}
          document.getElementById('zoho-form-container').style.display = 'none';
          document.getElementById('download-button-section').classList.remove('hidden');
          var ds = document.getElementById('download-section');
          if (ds) ds.classList.remove('hidden');
          {{/if}}
        })();
      </script>

    </div>
  </div>
</section>
