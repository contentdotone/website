<div class="customers-page">
  <section class="py-16 lg:py-24 bg-gradient-primary text-white overflow-hidden relative content-one-pattern border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="flex justify-center text-center">
        <div class="lg:max-w-4xl">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white text-royal text-xs font-semibold uppercase tracking-wider mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Loved by teams worldwide
          </span>
          <h1 class="text-5xl md:text-6xl lg:text-7xl text-white font-display font-semibold tracking-tight mb-4 leading-[1.05]">{{page.title}}</h1>
          <p class="text-lg md:text-xl text-white/80 mb-8 max-w-2xl mx-auto leading-relaxed">Discover how modern organizations launch, scale, and share their missions with Content.One.</p>
          <div class="inline-flex flex-wrap gap-3 justify-center">
            <a class="inline-flex items-center gap-2 rounded-full bg-white text-royal hover:bg-gray-100 font-semibold px-6 py-3 transition shadow-lg shadow-black/20" href="/contact-us/">
              Book an exploratory call
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a class="inline-flex items-center gap-2 rounded-full border border-white/30 text-white hover:bg-white/10 font-semibold px-6 py-3 transition" href="/blog/">
              Read the journal
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Aggregate proof strip -->
  <section class="py-12 lg:py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-gray-200 rounded-2xl overflow-hidden border border-gray-200">
        <div class="bg-white p-6 lg:p-8">
          <div class="font-display text-4xl lg:text-5xl font-bold text-royal leading-none">3,000+</div>
          <p class="text-gray-600 text-sm mt-3 leading-snug">Salvation Army locations on one federated platform</p>
        </div>
        <div class="bg-white p-6 lg:p-8">
          <div class="font-display text-4xl lg:text-5xl font-bold text-royal leading-none">2.25×</div>
          <p class="text-gray-600 text-sm mt-3 leading-snug">Faster go-live for Sony Electronics</p>
        </div>
        <div class="bg-white p-6 lg:p-8">
          <div class="font-display text-4xl lg:text-5xl font-bold text-royal leading-none">99.99%</div>
          <p class="text-gray-600 text-sm mt-3 leading-snug">Production uptime across the enterprise customer base</p>
        </div>
        <div class="bg-white p-6 lg:p-8">
          <div class="font-display text-4xl lg:text-5xl font-bold text-royal leading-none">+50%</div>
          <p class="text-gray-600 text-sm mt-3 leading-snug">Web traffic growth post-migration (Salvation Army)</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" id="customersGrid">
        {{each customer as customer}}
          <div data-customer-card data-code="{{customer.short_code}}">
            <article class="customer-card bg-white shadow-sm h-full rounded-2xl overflow-hidden flex flex-col">
              <div class="relative h-[220px] overflow-hidden">
                <img src="{{customer.header_image.getImage(640,360)}}" alt="{{customer.name}} background" class="absolute inset-0 w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-b from-gray-900/20 to-gray-900/65"></div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 inline-flex items-center justify-center bg-white/90 rounded-full px-5 py-3 shadow-lg">
                  {{if {customer.logo} }}
                    <img src="{{customer.logo.getImage(220,120)}}" alt="{{customer.name}} logo" class="max-w-[180px] max-h-[72px] object-contain">
                  {{else}}
                    <span class="font-semibold text-gray-900">{{customer.short_code}}</span>
                  {{end-if}}
                </div>
              </div>
              <div class="p-6 flex-1">
                <h3 class="font-display text-xl font-bold mb-2">{{customer.name}}</h3>
                <p class="text-gray-600 mb-3">{{customer.short_description.subwords(20)}}...</p>
                {{if {customer.short_code} }}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold text-bg-primary-soft">{{customer.short_code}}</span>
                {{end-if}}
              </div>
              <footer class="px-6 pb-6 bg-transparent">
                <a href="{{customer.getURL()}}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-royal hover:text-royalDark group/cta">
                  Read the story
                  <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 transition-transform group-hover/cta:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </footer>
            </article>
          </div>
        {{/each}}
      </div>
      <div class="text-center hidden" id="customersEmpty">
        <div class="bg-white shadow-sm rounded-2xl p-6 lg:p-10">
          <h3 class="font-display text-xl font-bold mb-2">No customers match your search… yet.</h3>
          <p class="text-gray-600 m-0">Try a different keyword or clear the filters to see the full library.</p>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .customers-page .bg-gradient-primary {
    background:
      linear-gradient(135deg, #0f172a 0%, #3f51b5 45%, #6f7bf7 100%),
      url("https://hj5v68xn.media.zestyio.com/content-one-background-pattern-10p.png");
    background-repeat: no-repeat, repeat;
    background-size: cover, 144px 131px;
    background-blend-mode: overlay;
  }
  .customers-page .text-bg-primary-soft {
    background-color: rgba(63, 81, 181, 0.12);
    color: #1e293b;
    border: 1px solid rgba(63, 81, 181, 0.32);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var filterGroup = document.getElementById('customerFilters');
    var searchInput = document.getElementById('customerSearch');
    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-customer-card]'));
    var emptyState = document.getElementById('customersEmpty');
    if (!filterGroup || !searchInput || !cards.length) return;
    var uniqueCodes = new Set();
    cards.forEach(function (card) {
      var code = card.getAttribute('data-code');
      if (code) { uniqueCodes.add(code.trim()); }
    });
    uniqueCodes.forEach(function (code) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'inline-flex items-center rounded-lg border border-royal text-royal hover:bg-royal/10 font-semibold px-3 py-1.5 text-sm transition';
      button.textContent = code;
      button.setAttribute('data-filter', code.toLowerCase());
      filterGroup.appendChild(button);
    });
    function getActiveFilter() {
      var activeButton = filterGroup.querySelector('.active');
      return activeButton ? activeButton.getAttribute('data-filter') : 'all';
    }
    function updateFilters(event) {
      var target = event.target;
      if (target.matches('[data-filter]')) {
        filterGroup.querySelectorAll('[data-filter]').forEach(function (btn) {
          btn.classList.toggle('active', btn === target);
        });
        applyFilter();
      }
    }
    function applyFilter() {
      var activeFilter = getActiveFilter();
      var query = searchInput.value.trim().toLowerCase();
      var visibleCount = 0;
      cards.forEach(function (card) {
        var code = (card.getAttribute('data-code') || '').toLowerCase();
        var textContent = card.textContent.toLowerCase();
        var matchesFilter = activeFilter === 'all' || code === activeFilter;
        var matchesSearch = !query || textContent.indexOf(query) !== -1;
        var isVisible = matchesFilter && matchesSearch;
        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      });
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    }
    filterGroup.addEventListener('click', updateFilters);
    searchInput.addEventListener('input', function () {
      window.requestAnimationFrame(applyFilter);
    });
    applyFilter();
  });
</script>
