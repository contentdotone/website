  .modal-lg .modal-dialog, .modal-dialog.modal-lg { max-width:48rem; }
  .modal-content { background:#fff; border-radius:1rem; box-shadow:0 24px 64px rgba(0,0,0,.25); overflow:hidden; }
  .modal-header { display:flex; align-items:center; justify-content:space-between; padding:1rem; border-bottom:1px solid #e5e7eb; }
  .modal-body { padding:1rem; }
  .modal-footer { padding:1rem; border-top:1px solid #e5e7eb; display:flex; gap:.5rem; justify-content:flex-end; }
  .modal-title { margin:0; font-size:1.125rem; font-weight:600; }
  .btn-close { background:transparent; border:0; font-size:1.5rem; line-height:1; color:#6b7280; cursor:pointer; padding:0 .5rem; }
  .btn-close:hover { color:#111827; }
  .btn-close::before { content:"\00d7"; }

  /* Accordion — Bootstrap-equivalent visuals */
  .accordion-item { background:#fff; border:1px solid #e5e7eb; }
  .accordion-item + .accordion-item { border-top:0; }
  .accordion-item:first-of-type { border-top-left-radius:.5rem; border-top-right-radius:.5rem; }
  .accordion-item:last-of-type { border-bottom-left-radius:.5rem; border-bottom-right-radius:.5rem; }
  .accordion-button { width:100%; padding:1rem; text-align:left; background:transparent; border:0; font-weight:600; display:flex; justify-content:space-between; align-items:center; cursor:pointer; color:inherit; }
  .accordion-button::after { content:""; width:1rem; height:1rem; background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23111827'><path d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/></svg>"); background-size:contain; background-repeat:no-repeat; transition:transform .2s; }
  .accordion-button.collapsed::after { transform:rotate(-90deg); }
  .accordion-collapse:not(.show) { display:none; }
  .accordion-body { padding:1rem; color:#4b5563; }

  /* Alerts — colored boxes */
  .alert { padding:.75rem 1rem; border:1px solid transparent; border-radius:.5rem; }
  .alert-primary { background:rgba(66,85,189,.08); border-color:rgba(66,85,189,.2); color:#1e3a8a; }
  .alert-secondary { background:#f3f4f6; border-color:#e5e7eb; color:#374151; }
  .alert-success { background:rgba(54,179,126,.12); border-color:rgba(54,179,126,.24); color:#065f46; }
  .alert-info { background:rgba(13,202,240,.1); border-color:rgba(13,202,240,.2); color:#075985; }
  .alert-warning { background:rgba(255,171,0,.12); border-color:rgba(255,171,0,.24); color:#78350f; }
  .alert-danger { background:rgba(255,86,48,.1); border-color:rgba(255,86,48,.2); color:#7f1d1d; }

  /* Buttons */
  .btn { display:inline-flex; align-items:center; justify-content:center; font-weight:600; padding:.5rem 1rem; border-radius:.5rem; transition:all .15s; cursor:pointer; text-decoration:none; border:0; line-height:1.4; }
  .btn-primary { background:#4255BD; color:#fff; }
  .btn-primary:hover { background:#2F3F94; }
  .btn-outline-primary { border:1px solid #4255BD; color:#4255BD; background:transparent; }
  .btn-outline-primary:hover { background:rgba(66,85,189,.08); }
  .btn-light { background:#fff; color:#111827; border:1px solid #e5e7eb; }
  .btn-light:hover { background:#f3f4f6; }
  .btn-outline-light { border:1px solid #fff; color:#fff; background:transparent; }
  .btn-outline-light:hover { background:rgba(255,255,255,.1); }
  .btn-warning { background:#FFAB00; color:#111827; }
  .btn-warning:hover { opacity:.9; }
  .btn-danger { background:#FF5630; color:#fff; }
  .btn-success { background:#36B37E; color:#fff; }
  .btn-link { color:#4255BD; background:transparent; text-decoration:underline; }
  .btn-lg { padding:.75rem 1.5rem; font-size:1.05rem; }
  .btn-sm { padding:.25rem .75rem; font-size:.85rem; }

  /* Form controls */
  .form-control, .form-select { display:block; width:100%; padding:.5rem .75rem; border:1px solid #d1d5db; border-radius:.375rem; font-size:1rem; line-height:1.4; background:#fff; }
  .form-control:focus, .form-select:focus { outline:none; border-color:#4255BD; box-shadow:0 0 0 3px rgba(66,85,189,.2); }
  .form-label { display:block; font-size:.875rem; font-weight:500; color:#374151; margin-bottom:.25rem; }
  .form-text { font-size:.875rem; color:#6b7280; margin-top:.25rem; }
  .input-group { display:flex; }
  .input-group > .form-control { border-radius:0; flex:1 1 auto; }
  .input-group > :first-child { border-top-left-radius:.375rem; border-bottom-left-radius:.375rem; }
  .input-group > :last-child { border-top-right-radius:.375rem; border-bottom-right-radius:.375rem; }
  .form-check { display:flex; align-items:center; gap:.5rem; }

  /* Badges */
  .badge { display:inline-flex; align-items:center; padding:.15rem .55rem; border-radius:9999px; font-size:.75rem; font-weight:500; }
  .badge-primary, .bg-primary.badge { background:#4255BD; color:#fff; }
  .badge-warning { background:#FFAB00; color:#111827; }

  /* Progress */
  .progress { width:100%; height:.5rem; background:#e5e7eb; border-radius:9999px; overflow:hidden; }
  .progress-bar { height:100%; background:#4255BD; transition:width .3s; }

  /* Navbar */
  .navbar { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; padding:.75rem 0; }
  .navbar-brand { font-size:1.125rem; font-weight:600; text-decoration:none; color:inherit; }
