    if (dismiss === 'offcanvas') { var oc = t.closest('.offcanvas'); if (oc) oc.classList.remove('is-open'); return; }
    if (dismiss === 'alert') { var al = t.closest('[role="alert"]'); if (al) al.remove(); return; }

    var toggle = t.getAttribute('data-bs-toggle');
    var target = t.getAttribute('data-bs-target') || t.getAttribute('href');

    if (toggle === 'collapse' && target) {
      e.preventDefault();
      qa(target).forEach(function (el) {
        var parent = el.getAttribute('data-bs-parent');
        if (parent) qa(parent + ' .collapse.show, ' + parent + ' [data-bs-collapse-open]').forEach(function (sib) { if (sib !== el) sib.classList.remove('show'); });
        el.classList.toggle('show');
      });
      return;
    }
    if (toggle === 'modal' && target) {
      var m = q(target); if (m) { if (m.showModal) m.showModal(); else m.classList.add('is-open'); }
      return;
    }
    if (toggle === 'dropdown') {
      e.preventDefault();
      var dropdown = t.closest('.dropdown, .nav-dropdown');
      qa('.dropdown.is-open, .nav-dropdown.is-open').forEach(function (d) { if (d !== dropdown) d.classList.remove('is-open'); });
      if (dropdown) dropdown.classList.toggle('is-open');
      return;
    }
    if (toggle === 'offcanvas' && target) {
      var oc = q(target); if (oc) oc.classList.add('is-open');
      return;
    }
    if ((toggle === 'tab' || toggle === 'pill') && target) {
      e.preventDefault();
      var pane = q(target);
      if (!pane) return;
      var container = pane.parentElement;
      qa('.tab-pane, [role="tabpanel"]', container).forEach(function (p) { p.classList.remove('show', 'active'); p.style.display = 'none'; });
      pane.classList.add('show', 'active'); pane.style.display = '';
