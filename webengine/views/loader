      carousel.dataset.tlInit = '1';
      var slides = qa('.carousel-item', carousel);
      if (!slides.length) return;
      slides.forEach(function (s, i) { if (i !== 0 && !s.classList.contains('active')) s.style.display = 'none'; });
      var interval = parseInt(carousel.getAttribute('data-bs-interval'), 10) || 6000;
