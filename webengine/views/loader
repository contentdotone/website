      var next = current;
      if (slideTo !== null) next = parseInt(slideTo, 10);
      else if (slide === 'next') next = (current + 1) % slides.length;
      else if (slide === 'prev') next = (current - 1 + slides.length) % slides.length;
      slides.forEach(function (s, i) {
        s.classList.toggle('active', i === next);
        s.classList.toggle('is-active', i === next);
        s.style.display = i === next ? '' : 'none';
      });
      qa('.carousel-indicators [data-bs-target="' + slideTarget + '"], .tw-carousel-dot', c).forEach(function (d, i) {
        d.classList.toggle('active', i === next);
        d.classList.toggle('is-active', i === next);
      });
    }
  });

