<!-- Lightweight CSS rules so the shim classes render correctly without theme.css.
     Mirrors Bootstrap visuals using Tailwind/brand tokens; safe to ship beside
     theme.css (cascade is mostly equivalent). When theme.css is dropped, the
     site stays usable. -->
<style>
  /* Collapse / details */
  .collapse:not(.show) { display: none; }
  .collapse.show { display: block; }

  /* Dropdown */
  .dropdown-menu, .nav-dropdown-menu { display: none; }
