  document.addEventListener('click', function (e) {
    if (!e.target.closest('.dropdown, .nav-dropdown')) {
      qa('.dropdown.is-open, .nav-dropdown.is-open').forEach(function (d) { d.classList.remove('is-open'); });
    }
