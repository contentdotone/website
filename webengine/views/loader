  .nav-link:hover, .nav-link.active { color:#4255BD; }

  /* Card */
  .card { background:#fff; border-radius:.75rem; box-shadow:0 1px 2px rgba(15,23,42,.05); overflow:hidden; }
  .card-body { padding:1.5rem; }
  .card-header { padding:1rem 1.5rem; border-bottom:1px solid #e5e7eb; }
  .card-footer { padding:1rem 1.5rem; border-top:1px solid #e5e7eb; }
