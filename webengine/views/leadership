<main class="leadership-page">
  <section class="leader-profile">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="leader-profile__grid">
        <div class="leader-profile__content">
          <p class="leader-profile__eyebrow">Leadership Profile</p>
          <h1 class="leader-profile__name">{{this.name}}</h1>
          <p class="leader-profile__title">{{this.title}}</p> 
          <div class="leader-profile__bio">{{this.bio}}</div>
        </div>
        <div class="leader-profile__media">
          <img src="{{this.image.getImage()}}" alt="{{this.name}} headshot">
        </div>
      </div>
    </div>
  </section>

  <section class="leader-related">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="leader-related__header">
        <p class="leader-related__eyebrow">Articles by {{this.name}}</p>
        <h2 class="leader-related__title">More leadership profiles</h2>
        <p class="leader-related__subtitle">Explore additional leaders across Content.One.</p>
      </div>
      <div class="leader-related__grid">
        {{each articles as article where article.authors like '%{this.zuid}%'}}
        <a href="{{article.getURL()}}" class="leader-card__link">
          <article class="leader-card">
            <div class="leader-card__media">
              {{if {article.main_image} }}
              <img src="{{article.main_image.getImage(600,720,crop)}}" alt="{{leader.name}} headshot">
              {{else}}
              <div class="leader-card__placeholder">{{article.title.subwords(1)}}</div>
              {{/if}}
            </div>
            <div class="leader-card__body">
              <h3 class="leader-card__name">{{article.name}}</h3>
              {{if {article.title} }}
              <p class="leader-card__title">{{article.title}}</p>
              {{/if}}
            </div>
          </article>
        </a>
        {{/each}}
      </div>
    </div>
  </section>
 
  <section class="leadership-hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="leadership-hero__eyebrow">Leadership</p>
      <h1 class="leadership-hero__title">Meet the people guiding Content.One.</h1>
      <p class="leadership-hero__subtitle">Focused on enterprise outcomes, trusted delivery, and modern content operations.</p>
    </div>
  </section>
    
  <section class="leadership-grid-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="leadership-grid">
        {{each leadership as leader where z.zuid != '{this.zuid}' order by leader.sort_order ASC}}
        <a href="{{leader.getURL()}}" class="leader-card__link">
          <article class="leader-card">
            <div class="leader-card__media">
              {{if {leader.image} }}
              <img src="{{leader.image.getImage(600,720,crop)}}" alt="{{leader.name}} headshot">
              {{else}}
              <div class="leader-card__placeholder">{{leader.name.subwords(1)}}</div>
              {{/if}}
            </div> 
            <div class="leader-card__body">
              <h2 class="leader-card__name">{{leader.name}}</h2>
              {{if {leader.title} }}
              <p class="leader-card__title">{{leader.title}}</p>
              {{/if}}
              {{if {leader.bio} }}
              <div class="leader-card__bio">{{leader.bio}}</div>
              {{/if}}
            </div>
          </article>
        </a>
        {{/each}}
      </div>
    </div>
  </section>
</main>

<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap");
  @import url("https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700&display=swap");

  .leadership-page {
    --ink: #0f172a;
    --muted: #475569;
    --surface: #ffffff;
    --brand-dark: #0f172a;
    --brand-mid: #3f51b5;
    --brand-bright: #6f7bf7;
    font-family: "Satoshi", "Segoe UI", sans-serif;
    color: var(--ink);
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.06) 0%, rgba(63, 81, 181, 0.08) 50%, rgba(111, 123, 247, 0.05) 100%);
  }

  .leadership-hero {
    padding: 4.5rem 0 3rem;
  }

  .leader-related {
    padding: 0 0 3.5rem;
  }

  .leader-related__header {
    max-width: 640px;
    margin-bottom: 1.8rem;
  }

  .leader-related__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .leader-related__title {
    font-family: "DM Sans", "Segoe UI", sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin: 0.6rem 0 0.4rem;
  }

  .leader-related__subtitle {
    color: var(--muted);
    margin: 0;
  }

  .leader-related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.2rem;
  }

  .leader-profile {
    padding: 4.5rem 0 2.5rem;
  }

  .leader-profile__grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 2rem;
    align-items: center;
  }

  .leader-profile__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .leader-profile__name {
    font-family: "DM Sans", "Segoe UI", sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    margin: 1rem 0 0.5rem;
  }

  .leader-profile__title {
    margin: 0 0 1.5rem;
    color: var(--brand-mid);
    font-weight: 600;
  }

  .leader-profile__bio {
    color: var(--muted);
    line-height: 1.7;
  }

  .leader-profile__media img {
    width: 100%;
    display: block;
    border-radius: 4px;
    box-shadow: 0 22px 50px rgba(15, 23, 42, 0.12);
  }

  .leadership-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .leadership-hero__title {
    font-family: "DM Sans", "Segoe UI", sans-serif;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    margin: 1rem 0;
  }

  .leadership-hero__subtitle {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 640px;
  }

  .leadership-grid-section {
    padding: 0 0 4rem;
  }

  .leadership-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .leader-card {
    background: var(--surface);
    border-radius: 4px;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }

  .leader-card__media {
    position: relative;
    background: rgba(15, 23, 42, 0.06);
  }

  .leader-card__media img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
  }

  .leader-card__placeholder {
    height: 280px;
    display: grid;
    place-items: center;
    font-family: "DM Sans", "Segoe UI", sans-serif;
    font-size: 2.4rem;
    color: var(--brand-mid);
  }

  .leader-card__body {
    padding: 1.6rem;
    display: grid;
    gap: 0.6rem;
  }

  .leader-card__name {
    margin: 0;
    font-size: 1.4rem;
  }

  .leader-card__title {
    margin: 0;
    color: var(--brand-mid);
    font-weight: 600;
  }

  .leader-card__bio {
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .leadership-hero {
      padding: 3.5rem 0 2.5rem;
    }

    .leader-related {
      padding-bottom: 3rem;
    }

    .leader-profile {
      padding: 3.5rem 0 2rem;
    }

    .leader-profile__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
