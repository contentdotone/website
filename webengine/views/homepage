<script>
  (function () {
    var testimonials = [
      {
        quote: "“Load times have improved dramatically, and stability has been night and day compared to our old platform. We’ve seen a 50% increase in traffic and double the location-search activity since launch.”",
        name: "Andrew Dobney",
        title: "Director of Digital Strategy",
        company: "The Salvation Army",
        image: "https://hj5v68xn.media.zestyio.com/andrew-dobney.jpg"
      },
      {
        quote: "“By using Content.One as our CMS, we were able to soft launch in six weeks and fully launch within two months.”",
        name: "Matthew Parnell",
        title: "MARCOM Manager",
        company: "Sony Electronics",
        image: "https://hj5v68xn.media.zestyio.com/matt.jpg"
      },
      {
        quote: "“Community polls, audio players, and other cool widgets snap into place on Content.One. We can brand everything without waiting on developers.”",
        name: "Kyle Lemmon",
        title: "Marketing Manager",
        company: "Psyonix",
        image: "https://hj5v68xn.media.zestyio.com/kyle-lemon.jpg"
      },
      {
        quote: "“We need software that's both secure and agile. After seven years, we continue to build on Content.One because the platform listens, evolves, and stays reliable.”",
        name: "Ben Johnson",
        title: "Director of Technology Operations",
        company: "Bluepixel",
        image: "https://hj5v68xn.media.zestyio.com/Ben.webp"
      }
    ];
    function initTestimonial(section) {
      var quoteEl = section.querySelector('[data-testimonial-quote]');
      var nameTitleEl = section.querySelector('[data-testimonial-name-title]');
      var companyEl = section.querySelector('[data-testimonial-company]');
      var avatarEls = section.querySelectorAll('[data-testimonial-avatar], [data-testimonial-portrait]');
      var prevBtn = section.querySelector('[data-testimonial-prev]');
      var nextBtn = section.querySelector('[data-testimonial-next]');
      if (!quoteEl || !nameTitleEl || !companyEl || !prevBtn || !nextBtn) return;
      var i = 0;
      function render() {
        var t = testimonials[i];
        quoteEl.textContent = t.quote;
        nameTitleEl.textContent = t.name + ', ' + t.title;
        companyEl.textContent = t.company;
        avatarEls.forEach(function (img) {
          img.src = t.image;
          img.alt = t.name + ', ' + t.title + ' at ' + t.company;
        });
      }
      function go(delta) {
        i = (i + delta + testimonials.length) % testimonials.length;
        render();
      }
      prevBtn.addEventListener('click', function () { go(-1); });
      nextBtn.addEventListener('click', function () { go(1); });
    }
    function init() {
      document.querySelectorAll('[data-testimonial-carousel]').forEach(initTestimonial);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

