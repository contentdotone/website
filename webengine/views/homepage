<style>
  /* Solutions accordion — Figma 14180:576842 */
  .sol-accordion .sol-tab {
    position: relative;
    border-left: 4px solid #f5f5f5;
    padding: 16px 24px;
    transition: border-color .15s ease;
  }
  /* Active-tab progress line: overlays the gray border, grows top-to-
     bottom over 3s to visualize the auto-advance timer. */
  .sol-accordion .sol-tab.sol-active::before {
    content: "";
    position: absolute;
    left: -4px; top: 0;
    width: 4px; height: 0;
    background: #3d52c2;
    animation: sol-progress 4s linear forwards;
  }
  /* When the section leaves the middle-50% viewport band we freeze the
     progress line at whatever height it reached. */
  .sol-accordion.sol-paused .sol-tab.sol-active::before {
    animation-play-state: paused;
  }
  /* No auto-advance for users on manual mode (clicked a tab) — show the
     border-left in royal instead of the progress bar. */
  .sol-accordion.sol-manual .sol-tab.sol-active { border-left-color: #3d52c2; }
  .sol-accordion.sol-manual .sol-tab.sol-active::before { display: none; }
  @keyframes sol-progress {
    from { height: 0; }
    to { height: 100%; }
  }
  /* Reduced-motion users: no growing bar, static full-height royal
     border on the active tab. */
  @media (prefers-reduced-motion: reduce) {
    .sol-accordion .sol-tab.sol-active { border-left-color: #3d52c2; }
    .sol-accordion .sol-tab.sol-active::before { display: none; }
  }
  .sol-accordion .sol-title {
    display: block; width: 100%; text-align: left;
    background: none; border: 0; padding: 0; margin: 0; cursor: pointer;
    font-family: 'Satoshi', 'DM Sans', system-ui, sans-serif;
    font-size: 18px; line-height: 28px; font-weight: 600; color: #171717;
    transition: color .15s ease;
  }
  .sol-accordion .sol-tab:not(.sol-active) .sol-title:hover { color: #253274; }
  /* Body opens/closes on a smooth max-height + opacity + margin-top
     transition instead of an instant display: none swap. */
  .sol-accordion .sol-body {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    margin-top: 0;
    transition: max-height .4s ease, opacity .3s ease .05s, margin-top .4s ease;
  }
  .sol-accordion .sol-tab.sol-active .sol-body {
    /* Cap is generous so no panel's copy gets silently clipped. Real
       height is measured by JS and locked into min-height on the
       accordion, so this only needs to be large enough to enable the
       expand transition. */
    max-height: 800px;
    opacity: 1;
    margin-top: 16px;
  }
  .sol-accordion .sol-body p {
    color: #525252; font-size: 16px; line-height: 24px;
    margin: 0 0 16px;
    font-family: 'Satoshi', 'DM Sans', system-ui, sans-serif;
  }
  .sol-learn {
    display: inline-flex; align-items: center; gap: 6px;
    color: #253274; font-weight: 600; font-size: 16px;
    text-decoration: none; transition: color .15s ease;
  }
  .sol-learn:hover { color: #4255BD; }
  .sol-learn svg { transition: transform .15s ease; }
  .sol-learn:hover svg { transform: translateX(2px); }
  /* Solution image container — image swaps via JS on tab click. Small
     fade so the change reads as intentional. */
  .sol-image img { transition: opacity .2s ease; }
  .sol-image.sol-image-fading img { opacity: 0; }

  /* Suppress every transition/animation on the accordion while JS
     measures each state's height for the min-height lock, so the
     temporary class swaps don't produce a visible flash. */
  .sol-accordion.sol-measuring,
  .sol-accordion.sol-measuring *,
  .sol-accordion.sol-measuring *::before {
    transition: none !important;
    animation: none !important;
  }
</style>

<script>
  (function () {
    var root = document.querySelector('.sol-accordion');
    if (!root) return;
    var section = root.closest('section');
    var tabs = root.querySelectorAll('.sol-tab');
    var imgWrap = document.querySelector('.sol-image');
    var imgEl = imgWrap ? imgWrap.querySelector('img') : null;
    // Preload all solution images so the first swap on each doesn't flash.
    tabs.forEach(function (t) {
      var url = t.getAttribute('data-img');
      if (url) { var pre = new Image(); pre.src = url; }
    });

    var currentIdx = 0;
    var timerId = null;
    var manual = false;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Lock the accordion column to the height of its tallest expanded
    // state so switching tabs never shifts layout. Measurement toggles
    // sol-active across each tab (transitions suppressed via
    // .sol-measuring) and takes the max offsetHeight.
    function lockMinHeight() {
      root.style.minHeight = '';
      root.classList.add('sol-measuring');
      var maxH = 0;
      for (var i = 0; i < tabs.length; i++) {
        for (var j = 0; j < tabs.length; j++) {
          tabs[j].classList.toggle('sol-active', j === i);
        }
        var h = root.offsetHeight;
        if (h > maxH) maxH = h;
      }
      // Restore the original active tab.
      for (var k = 0; k < tabs.length; k++) {
        tabs[k].classList.toggle('sol-active', k === currentIdx);
      }
      root.style.minHeight = maxH + 'px';
      // Re-enable transitions after the paint that reflects the restore.
      window.requestAnimationFrame(function () {
        root.classList.remove('sol-measuring');
      });
    }
    lockMinHeight();
    // Remeasure once web fonts finish loading — Satoshi/DM Sans arrive
    // async, and pre-font metrics differ from final metrics enough to
    // shift a locked height by 10-20px per panel.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(lockMinHeight);
    }
    // Belt-and-braces: also remeasure after full page load (all images
    // + late CSS in), in case fonts.ready isn't supported.
    window.addEventListener('load', lockMinHeight);
    // Re-measure on resize (debounced) since copy wraps differently
    // at narrower widths.
    var resizeT = null;
    window.addEventListener('resize', function () {
      if (resizeT) window.clearTimeout(resizeT);
      resizeT = window.setTimeout(lockMinHeight, 150);
    });

    function setActive(i) {
      currentIdx = i;
      tabs.forEach(function (t, j) { t.classList.toggle('sol-active', j === i); });
      if (imgEl) {
        var next = tabs[i].getAttribute('data-img');
        var alt = tabs[i].getAttribute('data-alt') || 'Solution illustration';
        if (next && next !== imgEl.getAttribute('src')) {
          imgWrap.classList.add('sol-image-fading');
          window.setTimeout(function () {
            imgEl.src = next;
            imgEl.alt = alt;
            imgWrap.classList.remove('sol-image-fading');
          }, 180);
        }
      }
    }

    function advance() { setActive((currentIdx + 1) % tabs.length); }

    function startTimer() {
      if (timerId || manual || reduceMotion) return;
      root.classList.remove('sol-paused');
      timerId = window.setInterval(advance, 4000);
    }
    function stopTimer(pauseVisual) {
      if (timerId) { window.clearInterval(timerId); timerId = null; }
      if (pauseVisual) root.classList.add('sol-paused');
    }

    // Only auto-advance when the section sits in the middle 50% of the
    // viewport. rootMargin: -25% top and bottom shrinks the observer
    // root to just the middle band; when any part of the section
    // intersects that band we're "in view".
    if ('IntersectionObserver' in window && section) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) startTimer();
          else stopTimer(true);
        });
      }, { rootMargin: '-25% 0px -25% 0px' });
      io.observe(section);
    } else if (!reduceMotion) {
      // No IO support → just auto-advance always.
      startTimer();
    }

    // Manual tab click → stop auto-advance permanently for this pageview
    // and switch the active-state visual from the growing bar to a
    // static full-height royal border (via .sol-manual on the root).
    tabs.forEach(function (t, i) {
      var title = t.querySelector('.sol-title');
      if (title) title.addEventListener('click', function () {
        manual = true;
        stopTimer(false);
        root.classList.add('sol-manual');
        setActive(i);
      });
    });
  })();
</script>

