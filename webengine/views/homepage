<style>
  /* Hero background — Figma node 13849:10870.
     Diagonal linear gradient, deep royal-navy top-left → near-black
     bottom-right. Fallback color set for browsers that don't render
     the gradient. */
  .co-hero {
    background-color: #0C1027;
    background-image: linear-gradient(180deg, #253274 0%, #0C1027 53.133%);
  }
  .co-hero__badge { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: #c7d2fe; backdrop-filter: blur(8px); }
  .rotate { display: inline-block; transition: opacity .2s ease, transform .2s ease; }
  .rotate.is-fading { opacity: 0; transform: translateY(-6px); }
</style>

<script>
  (function () {
    var rotateEl = document.querySelector('.rotate');
    if (!rotateEl) return;
    var words = ['Content', 'Website', 'Mobile', 'Headless'];
    var colors = ['#a78bfa', '#38bdf8', '#34d399', '#f59e0b'];
    var index = 0;
    rotateEl.textContent = words[index];
    rotateEl.style.color = colors[index];
    window.setInterval(function () {
      rotateEl.classList.add('is-fading');
      window.setTimeout(function () {
        index = (index + 1) % words.length;
        rotateEl.textContent = words[index];
        rotateEl.style.color = colors[index];
        rotateEl.classList.remove('is-fading');
      }, 200);
    }, 2000);
  })();
</script>

