<style>
  .co-hero { background-color: #0b0f1f; }
  .co-hero__bg {
    background: linear-gradient(135deg, #0b0f1f 0%, #1a1545 35%, #2a1d6b 60%, #1a1545 80%, #0b0f1f 100%);
    z-index: 0;
  }
  .co-hero__bg::after {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 30% 50%, rgba(99, 60, 255, 0.18) 0%, transparent 65%),
                radial-gradient(ellipse at 70% 30%, rgba(56, 189, 248, 0.10) 0%, transparent 55%);
    pointer-events: none;
  }
  .co-hero__badge { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: #c7d2fe; }
  .rotate { display: inline-block; transition: opacity .2s ease, transform .2s ease; }
  .rotate.is-fading { opacity: 0; transform: translateY(-6px); }
</style>

<script>
  (function () {
    var rotateEl = document.querySelector('.rotate');
    if (!rotateEl) return;
    var words = ['Content', 'Website', 'Mobile', 'Headless'];
    var colors = ['#a78bfa', '#38bdf8', '#34d399', '#f59e0b'];
    var index = 0;
    rotateEl.textContent = words[index];
    rotateEl.style.color = colors[index];
    window.setInterval(function () {
      rotateEl.classList.add('is-fading');
      window.setTimeout(function () {
        index = (index + 1) % words.length;
        rotateEl.textContent = words[index];
        rotateEl.style.color = colors[index];
        rotateEl.classList.remove('is-fading');
      }, 200);
    }, 2000);
  })();
</script>

